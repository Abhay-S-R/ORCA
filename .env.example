# ORCA — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# NEVER put a real value in this file.
#
# Column key:
#   [P1] needed for Phase 1 (the Tamil safety query)
#   [P2] needed by Phase 2
#   [P3] needed by Phase 3
#   [--] optional / later
#
# Where a service allows free self-registration, EVERY engineer should register
# their own key rather than sharing one. Six people behind a single key is a
# real rate-limit failure during integration week.


# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────

# [P1] local | staging | production — drives log level and cache TTL behaviour
ORCA_ENV=local

# [P1] Absolute path to the data tree. Defaults to ./data if unset.
ORCA_DATA_DIR=

# [P1] Per-tier LLM routing. Tiers are fixed per agent (see the implementation
#      plan); providers are configuration and get decided by the Phase 2
#      bake-off. Provider must be one registered in orca/llm/registry.py.
#        cheap     -> Agents 1 (persona inference), 2 (fallback), 3
#        mid       -> Agent 9 (Reporting)
#        reasoning -> Agents 5 (DEEP diagnostics), 10 (Critic)
#      Agents 4, 6, 7, 11 and 12 never call an LLM — the safety path is
#      provider-independent by construction.
#
# [P2] FILLED IN (P2.13). These were blank, so every tier silently resolved to
#      the same Flash-Lite default in orca/llm/tiers.py — including the Critic,
#      which now runs on EVERY query (P2.5) and is the most reasoning-heavy
#      call ORCA makes. Gemini's free tier is per-minute, and a demo asks
#      questions faster than that: an unbudgeted run 429s mid-recording.
#      Cheapest model that can do each job, not the best one available.
#      MEASURED 2026-09-21: gemini-3.5-flash is a slow thinking model - 15-26 s for a three-sentence
#      answer vs 1.8-4 s for gemini-3.5-flash-lite. With the Critic on every query, a Flash mid/reasoning
#      tier made one question take 2-3 minutes. Keep every tier on Flash-Lite unless a tier has a
#      reason to be slow.
ORCA_LLM_CHEAP_PROVIDER=gemini
ORCA_LLM_CHEAP_MODEL=gemini-3.5-flash-lite
ORCA_LLM_MID_PROVIDER=gemini
ORCA_LLM_MID_MODEL=gemini-3.5-flash-lite
ORCA_LLM_REASONING_PROVIDER=gemini
ORCA_LLM_REASONING_MODEL=gemini-3.5-flash-lite

# [P2] P2.11 (`R-NEW-3`) — the "prove the LLM is optional" switch. `0` disables
#      every provider: the verdict, thresholds, geofence, citations and
#      confidence all still render from deterministic code, and only the prose
#      narration degrades to the verdict line. Leave it at 1; the demo uses the
#      per-query form `/query?...&llm=off`, which needs no restart.
ORCA_LLM_ENABLED=1

# [P2] P2.8 — Tier-2 intent routing. Blank uses intfloat/multilingual-e5-small
#      (~120 MB, CPU, downloaded once from HuggingFace). If it cannot be
#      downloaded, routing degrades to the previous word-overlap scorer and
#      says so in the log — it does not fail.
ORCA_INTENT_EMBED_MODEL=
#      Cosine threshold, tuned against tests/unit/test_intent_embeddings.py's
#      30-paraphrase gate. Retune if the model above changes.
ORCA_INTENT_EMBED_THRESHOLD=


# ─────────────────────────────────────────────────────────────────────────────
# LLM providers — fill in only the ones your tier config actually references
# ─────────────────────────────────────────────────────────────────────────────

# [P1] https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [P1] https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [P1] https://aistudio.google.com/apikey  — has a usable free tier.
#      Also picked up by `graphify extract` for semantic doc extraction.
GEMINI_API_KEY=

# [--] https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# [--] Local models. Default http://localhost:11434 when running Ollama.
OLLAMA_BASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Marine & weather data sources
# ─────────────────────────────────────────────────────────────────────────────
#
# No key required (do not add one): INCOIS ERDDAP, INCOIS PFZ text endpoint,
# Open-Meteo Marine, NDMA SACHET CAP, GEBCO, Marine Regions (VLIZ), WDPA.

# [P1] https://api.imd.gov.in — registration-based. Preferred source for the
#      Palk Bay pilot region; Open-Meteo's 0.25 deg global grid is too coarse
#      for shallow enclosed water and is the offshore baseline only.
IMD_API_KEY=

# [P2] https://stormglass.io/ — tide fallback where Survey of India harmonics
#      are missing. Free tier is 10 requests/day, so treat it as a fallback and
#      not a primary. Shared key: one owner, used sparingly.
STORMGLASS_API_KEY=

# [P2] https://marine.copernicus.eu/ — free registration, username + password
#      rather than an API key. Used for SST/reanalysis where a researcher-depth
#      historical query beats MOSDAC near-real-time.
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# [P2] https://urs.earthdata.nasa.gov/ — free. Needed to download actual MODIS
#      chlorophyll rasters; we currently hold granule metadata only. MOSDAC
#      OCM-3 chlorophyll is the primary Indian source, so this is a backup.
EARTHDATA_TOKEN=

# [--] https://globalfishingwatch.org/our-apis/ — vessel activity. Not on any
#      critical path; used for context layers only.
GFW_API_KEY=

# [--] https://www.mosdac.gov.in/ — set only if standing-order download is
#      scripted. Products for the pilot region are already on disk.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# Language & voice
# ─────────────────────────────────────────────────────────────────────────────

# [P3] https://bhashini.gov.in/ulca — ACCESS PENDING as of 2026-09-02.
#      Leave blank until granted. Agent 1 falls back to local IndicTrans2
#      automatically, and Phase 1 is built to ship on that local path, so a
#      blank value here must never break a build or a demo.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=

# [P3] Fallback TTS if Bhashini TTS is unavailable.
GOOGLE_CLOUD_TTS_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure
# ─────────────────────────────────────────────────────────────────────────────

# [P2] Postgres with the PostGIS extension. docker-compose provides this
#      locally; Phase 1 runs on in-memory GeoPandas and does not need it.
#      Host port is 5433, not 5432 (docker-compose.yml) — several dev
#      machines already run a native Postgres service on 5432, and Docker's
#      forwarding loses that conflict silently rather than erroring, which
#      then looks like a wrong password. If you get "password authentication
#      failed" against a fresh container, check `netstat`/`Get-Process -Id`
#      on 5432 before suspecting the compose file.
DATABASE_URL=postgresql://orca:orca@localhost:5433/orca

# [P2] Redis — cache TTLs, request coalescing.
REDIS_URL=redis://localhost:6379/0

# [P2] JWT signing secret (orca/auth/security.py). Generate a real random
# value per environment — never reuse the same secret across dev/staging/prod.
ORCA_JWT_SECRET=

# [--] OpenTelemetry collector. Unset means spans go to the local trace store,
#      which is all the reasoning-graph UI needs.
OTEL_EXPORTER_OTLP_ENDPOINT=

# [--] Web Push (P7.3, orca_final §12.1) — the one real notification channel;
#      every other channel in channels/renderers.py is rendered + simulated.
#      Generate locally with `vapid --gen` (the `py-vapid` package, a
#      `pywebpush` dependency) or `npx web-push generate-vapid-keys`; NEVER
#      commit a real keypair, and rotating it invalidates every existing
#      browser subscription (each one is signed with the key that made it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL identifying the sender, required by the Web Push
# protocol (RFC 8292) so a push service has somewhere to complain to about
# abuse — not a user-facing value.
VAPID_SUBJECT=


# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — NEXT_PUBLIC_* values are exposed to the browser.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# [P1] Backend base URL the browser calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# [--] Map tile provider, if we move off the default OSM tiles.
NEXT_PUBLIC_MAP_TILE_URL=
